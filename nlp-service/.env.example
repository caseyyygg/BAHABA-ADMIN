# Copy to .env and set private local values. Never commit .env or send tokens in chat.
# ZIP files provided for this BAHABA model integration:
FLOOD_MODEL_ZIP=C:\Users\Jakes\Downloads\drive-download-20260928T025654Z-1-001.zip
SEVERITY_MODEL_ZIP=C:\Users\Jakes\Downloads\drive-download-20260928T025742Z-1-001.zip
URGENCY_MODEL_ZIP=C:\Users\Jakes\Downloads\drive-download-20260928T025751Z-1-001.zip
LOCATION_MODEL_ZIP=C:\Users\Jakes\Downloads\checkpoint-286-20260928T025733Z-1-001.zip

# Generate separate long random values locally and set the matching values in:
# BAHABA_INGEST_TOKEN -> api/config.php as nlp_ingest_token
# NLP_SERVICE_TOKEN   -> your post-source collector
BAHABA_INGEST_URL=http://127.0.0.1:8001/api.php?action=nlp-ingest
BAHABA_INGEST_TOKEN=replace-me-with-the-same-local-api-ingest-token
NLP_SERVICE_TOKEN=replace-me-with-a-separate-collector-token

# Optional automatic collection from a Facebook Page you manage.
# Requires an authorized Page access token with the Page post-reading permissions granted by Meta.
FACEBOOK_GRAPH_API_VERSION=v24.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Real-time Pages webhook configuration. Use a random verify token you create (not an access token).
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Public HTTPS callback URL; the service route is /webhooks/facebook.
FACEBOOK_WEBHOOK_PUBLIC_URL=https://your-public-host.example/webhooks/facebook
FACEBOOK_POLL_SECONDS=60
FACEBOOK_INITIAL_BACKFILL=1
# Set these only if this Page represents a single area; leave blank for a city-wide/general Page.
FACEBOOK_DEFAULT_CITY=
FACEBOOK_DEFAULT_BARANGAY=

# Match any of these case-insensitive terms in posts from the authorized Facebook Page.
FACEBOOK_KEYWORDS=["baha","flood","lubog"]

# Apify social keyword searches: disabled until a token is added and explicitly enabled.
# Actors: scraper_one/facebook-posts-search, xquik/x-tweet-scraper, themineworks/threads-scraper.
APIFY_SOCIAL_ENABLED=false
APIFY_API_TOKEN=
APIFY_KEYWORDS=["baha","flood","lubog"]
APIFY_POLL_SECONDS=3600
APIFY_MAX_RESULTS=1
APIFY_MAX_TOTAL_CHARGE_USD=0.005

# Self-hosted public RSS/Atom collection. Use a JSON array of feed URLs, not regular page URLs.
RSS_FEED_URLS=[]
RSS_POLL_SECONDS=300
RSS_INITIAL_BACKFILL=10
RSS_DEFAULT_CITY=
RSS_DEFAULT_BARANGAY=

# Optional; the first launch extracts approximately 2.8 GB of model weights here.
MODEL_CACHE_DIR=model-cache
